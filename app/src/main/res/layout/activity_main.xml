<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tete avec logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_bobine"
                android:contentDescription="Logo bobine" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Bambu RFID Reader"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texte_principal" />
        </LinearLayout>

        <!-- Recherche inverse : trouver un tag Bambu proche d'un code hexa saisi -->
        <Button
            android:id="@+id/btnChercherCouleur"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Chercher une couleur par code hexa"
            android:textColor="@color/bambu_teal_fonce"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <!-- Carte principale de resultat, avec vraie ombre portee -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:background="@drawable/barre_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgNfc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_nfc"
                        android:contentDescription="Icone NFC"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:id="@+id/vuCouleur"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        android:background="@drawable/forme_couleur" />

                    <TextView
                        android:id="@+id/txtStatut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Approche une bobine Bambu du dos du telephone..."
                        android:textColor="@color/texte_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <!-- Lignes d'infos avec icones, remplies dynamiquement -->
                    <LinearLayout
                        android:id="@+id/layoutLignesInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <!-- Detail technique complet, en texte simple, selectionnable -->
                    <TextView
                        android:id="@+id/txtResultat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bouton principal -->
        <Button
            android:id="@+id/btnImprimerEtiquette"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="Imprimer une etiquette"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnExporter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Exporter le dernier dump"
            android:textColor="@color/bambu_teal_fonce"
            android:textAllCaps="false" />

        <!-- Boutons secondaires -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnCopier"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Copier"
                android:textColor="@color/bambu_teal_fonce"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPartager"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Partager"
                android:textColor="@color/bambu_teal_fonce"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnHistorique"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Historique"
                android:textColor="@color/bambu_teal_fonce"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
